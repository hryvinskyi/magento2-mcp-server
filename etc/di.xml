<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Hryvinskyi\McpServer\Api\ConfigInterface" type="Hryvinskyi\McpServer\Model\Config"/>
    <preference for="Hryvinskyi\McpServer\Api\McpEndpointInterface" type="Hryvinskyi\McpServer\Model\McpEndpointPlaceholder"/>
    <preference for="Hryvinskyi\McpServer\Api\Data\AbilityInterface" type="Hryvinskyi\McpServer\Model\Data\Ability"/>
    <preference for="Hryvinskyi\McpServer\Api\Data\AbilityPageInterface" type="Hryvinskyi\McpServer\Model\Data\AbilityPage"/>
    <preference for="Hryvinskyi\McpServer\Api\Data\CallerInterface" type="Hryvinskyi\McpServer\Model\Data\Caller"/>
    <preference for="Hryvinskyi\McpServer\Api\Data\ClientInterface" type="Hryvinskyi\McpServer\Model\Data\Client"/>
    <preference for="Hryvinskyi\McpServer\Api\Data\InvocationInterface" type="Hryvinskyi\McpServer\Model\Data\Invocation"/>
    <preference for="Hryvinskyi\McpServer\Api\Data\InvocationResultInterface" type="Hryvinskyi\McpServer\Model\Data\InvocationResult"/>

    <!-- Exposure: stored overrides, the built-in deny-list and the policy that weighs every rule -->
    <preference for="Hryvinskyi\McpServer\Api\Data\AbilityOverrideInterface" type="Hryvinskyi\McpServer\Model\AbilityOverride"/>
    <preference for="Hryvinskyi\McpServer\Api\AbilityOverrideRepositoryInterface" type="Hryvinskyi\McpServer\Model\AbilityOverrideRepository"/>
    <preference for="Hryvinskyi\McpServer\Api\ExposurePolicyInterface" type="Hryvinskyi\McpServer\Model\Exposure\ExposurePolicy"/>
    <preference for="Hryvinskyi\McpServer\Api\Data\ExposureDecisionInterface" type="Hryvinskyi\McpServer\Model\Data\ExposureDecision"/>
    <type name="Hryvinskyi\McpServer\Model\Exposure\ExposurePolicy">
        <arguments>
            <argument name="rules" xsi:type="array">
                <item name="denyList" xsi:type="object">Hryvinskyi\McpServer\Model\Exposure\Rule\DenyListRule</item>
                <item name="builtInDenyList" xsi:type="object">Hryvinskyi\McpServer\Model\Exposure\Rule\BuiltInDenyListRule</item>
                <item name="readOnlyMode" xsi:type="object">Hryvinskyi\McpServer\Model\Exposure\Rule\ReadOnlyModeRule</item>
                <item name="anonymousAbility" xsi:type="object">Hryvinskyi\McpServer\Model\Exposure\Rule\AnonymousAbilityRule</item>
                <item name="confirmation" xsi:type="object">Hryvinskyi\McpServer\Model\Exposure\Rule\ConfirmationRule</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Exposure\Rule\BuiltInDenyListRule">
        <arguments>
            <argument name="patterns" xsi:type="array">
                <item name="token_issuers_and_integrations" xsi:type="string">integration.*</item>
                <item name="two_factor_authentication" xsi:type="string">two_factor_auth.*</item>
                <item name="jwt_user_tokens" xsi:type="string">jwt_user_token.*</item>
                <item name="login_as_customer" xsi:type="string">login_as_customer*.*</item>
                <item name="customer_password_reset" xsi:type="string">customer.account_management.*password*</item>
                <!-- GraphQL mutations that issue, revoke, exchange or delete a token: sign-in and payment tokens alike -->
                <item name="graphql_tokens" xsi:type="string">graphql.mutation.*token*</item>
                <item name="graphql_customer_passwords" xsi:type="string">graphql.mutation.*password*</item>
            </argument>
        </arguments>
    </type>

    <!-- The ACL every MCP check asks: whether the caller may use the endpoint over stdio, and whether it may call an
         ability. These are the module's own instances, built the first time an MCP check needs them, so they take the
         role locator of the area loaded by then. Magento builds every console command, and with it whatever their
         constructors need, before any command runs; a command that loads a web API area afterwards would otherwise
         keep a shared ACL built for the global area, whose role locator finds no role and denies every caller -->
    <virtualType name="HryvinskyiMcpServerAuthorization" type="Magento\Framework\Authorization"/>
    <virtualType name="HryvinskyiMcpServerWebapiAuthorization" type="Magento\Framework\Webapi\Authorization">
        <arguments>
            <argument name="authorization" xsi:type="object">HryvinskyiMcpServerAuthorization</argument>
        </arguments>
    </virtualType>

    <!-- Catalog and invoker: every source's abilities by name, and the checked call of one of them -->
    <preference for="Hryvinskyi\McpServer\Api\AbilityCatalogInterface" type="Hryvinskyi\McpServer\Model\AbilityCatalog"/>
    <preference for="Hryvinskyi\McpServer\Model\Catalog\AbilitySourceResolverInterface" type="Hryvinskyi\McpServer\Model\AbilityCatalog"/>
    <preference for="Hryvinskyi\McpServer\Api\AbilityInvokerInterface" type="Hryvinskyi\McpServer\Model\AbilityInvoker"/>
    <preference for="Hryvinskyi\McpServer\Model\Clock\ClockInterface" type="Hryvinskyi\McpServer\Model\Clock\HrtimeClock"/>
    <type name="Hryvinskyi\McpServer\Model\AbilityCatalog">
        <arguments>
            <!-- Ability sources keyed by their code; a module adds its own source as an item here. The first source
                 in sortOrder keeps a name that two sources offer, and an item without a sortOrder counts as 0 -->
            <argument name="sources" xsi:type="array">
                <item name="pool" xsi:type="object" sortOrder="10">Hryvinskyi\McpServer\Model\Source\Pool\PoolAbilitySource</item>
                <item name="webapi" xsi:type="object" sortOrder="20">Hryvinskyi\McpServer\Model\Source\Webapi\WebapiAbilitySource</item>
                <item name="graphql" xsi:type="object" sortOrder="30">Hryvinskyi\McpServer\Model\Source\GraphQl\GraphQlAbilitySource</item>
            </argument>
        </arguments>
    </type>

    <!-- Pool source: abilities other modules register here -->
    <type name="Hryvinskyi\McpServer\Model\Source\Pool\PoolAbilitySource">
        <arguments>
            <argument name="authorization" xsi:type="object">HryvinskyiMcpServerWebapiAuthorization</argument>
            <!-- Hryvinskyi\McpServer\Api\PoolAbilityInterface items keyed by the ability's name -->
            <argument name="abilities" xsi:type="array"/>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\AbilityInvoker">
        <arguments>
            <!-- Invocation listeners keyed by a name; a module that records calls adds its listener here -->
            <argument name="listeners" xsi:type="array"/>
            <!-- Invocation guards keyed by a name; each may refuse a call for the arguments it carries -->
            <argument name="guards" xsi:type="array">
                <item name="customerPasswordHash" xsi:type="object">Hryvinskyi\McpServer\Model\Guard\CustomerPasswordHashGuard</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Guard\CustomerPasswordHashGuard">
        <arguments>
            <argument name="ability" xsi:type="string">customer.customer_repository.save</argument>
        </arguments>
    </type>

    <!-- Web API source: every webapi.xml route's service method as an ability -->
    <preference for="Hryvinskyi\McpServer\Model\Service\ServiceLocatorInterface" type="Hryvinskyi\McpServer\Model\Service\ObjectManagerServiceLocator"/>
    <preference for="Hryvinskyi\McpServer\Model\Source\Webapi\Metadata\MetadataReaderInterface" type="Hryvinskyi\McpServer\Model\Source\Webapi\Metadata\ServiceMetadataReader"/>
    <preference for="Hryvinskyi\McpServer\Model\Source\Webapi\Schema\InputSchemaBuilderInterface" type="Hryvinskyi\McpServer\Model\Source\Webapi\Schema\CachedInputSchemaBuilder"/>
    <type name="Hryvinskyi\McpServer\Model\Source\Webapi\WebapiAbilitySource">
        <arguments>
            <argument name="authorization" xsi:type="object">HryvinskyiMcpServerWebapiAuthorization</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Source\Webapi\Schema\CachedInputSchemaBuilder">
        <arguments>
            <argument name="inner" xsi:type="object">Hryvinskyi\McpServer\Model\Source\Webapi\Schema\InputSchemaBuilder</argument>
            <argument name="cache" xsi:type="object">Hryvinskyi\McpServer\Model\Cache\Type\McpCache</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Source\Webapi\Metadata\ServiceMetadataReader">
        <arguments>
            <!-- Remembers a failed build of the Web API metadata for a few minutes -->
            <argument name="cache" xsi:type="object">Hryvinskyi\McpServer\Model\Cache\Type\McpCache</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Source\Webapi\RouteAbilityBuilder">
        <arguments>
            <!-- Access by ability name (read, write or delete) for a route whose HTTP method tells the wrong story, such as a GET route that changes data -->
            <argument name="accessOverrides" xsi:type="array"/>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Source\Webapi\RouteIndex">
        <arguments>
            <!-- Service interfaces whose routes are never abilities; the module's own endpoint is one -->
            <argument name="excludedServices" xsi:type="array">
                <item name="mcpEndpoint" xsi:type="string">Hryvinskyi\McpServer\Api\McpEndpointInterface</item>
            </argument>
        </arguments>
    </type>

    <!-- GraphQL: settings, the guest client of the store's own endpoint, and its schema read by introspection -->
    <preference for="Hryvinskyi\McpServer\Model\Source\GraphQl\GraphQlConfigInterface" type="Hryvinskyi\McpServer\Model\Source\GraphQl\GraphQlConfig"/>
    <preference for="Hryvinskyi\McpServer\Model\Source\GraphQl\Client\EndpointInterface" type="Hryvinskyi\McpServer\Model\Source\GraphQl\Client\EndpointUrl"/>
    <preference for="Hryvinskyi\McpServer\Model\Source\GraphQl\Client\GraphQlClientInterface" type="Hryvinskyi\McpServer\Model\Source\GraphQl\Client\HttpGraphQlClient"/>
    <preference for="Hryvinskyi\McpServer\Model\Source\GraphQl\Schema\SchemaProviderInterface" type="Hryvinskyi\McpServer\Model\Source\GraphQl\Schema\CachedSchemaProvider"/>
    <preference for="Hryvinskyi\McpServer\Model\Source\GraphQl\Client\StoredConfigInterface" type="Hryvinskyi\McpServer\Model\Source\GraphQl\Client\StoredSystemConfig"/>
    <type name="Hryvinskyi\McpServer\Model\Source\GraphQl\Client\StoredSystemConfig">
        <arguments>
            <!-- Settings as stored, before Magento resolves their placeholders: app/etc first, then the database -->
            <argument name="deploymentConfig" xsi:type="object">systemConfigInitialDataProvider</argument>
            <argument name="databaseConfig" xsi:type="object">Magento\Config\App\Config\Source\RuntimeConfigSource</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Source\GraphQl\Schema\CachedSchemaProvider">
        <arguments>
            <argument name="inner" xsi:type="object">Hryvinskyi\McpServer\Model\Source\GraphQl\Schema\IntrospectionSchemaProvider</argument>
            <argument name="cache" xsi:type="object">Hryvinskyi\McpServer\Model\Cache\Type\McpCache</argument>
        </arguments>
    </type>

    <!-- GraphQL source: every root field of the store's GraphQL schema as a guest ability -->
    <type name="Hryvinskyi\McpServer\Model\Source\GraphQl\GraphQlAbilitySource">
        <arguments>
            <argument name="authorization" xsi:type="object">HryvinskyiMcpServerWebapiAuthorization</argument>
            <!-- Root fields never offered, as "<operation> <field>": these query fields answer only a signed-in customer, so a guest always gets an authorization error from them -->
            <argument name="excludedFields" xsi:type="array">
                <item name="customer" xsi:type="string">query customer</item>
                <item name="customerCart" xsi:type="string">query customerCart</item>
                <item name="customerDownloadableProducts" xsi:type="string">query customerDownloadableProducts</item>
                <item name="customerOrders" xsi:type="string">query customerOrders</item>
                <item name="customerPaymentTokens" xsi:type="string">query customerPaymentTokens</item>
                <item name="wishlist" xsi:type="string">query wishlist</item>
            </argument>
        </arguments>
    </type>

    <!-- MCP protocol: sessions and confirmation tokens kept in the database, limits, the JSON-RPC method handlers and the meta-tools -->
    <preference for="Hryvinskyi\McpServer\Model\Clock\WallClockInterface" type="Hryvinskyi\McpServer\Model\Clock\SystemWallClock"/>
    <preference for="Hryvinskyi\McpServer\Model\Session\SessionStoreInterface" type="Hryvinskyi\McpServer\Model\Session\DbSessionStore"/>
    <preference for="Hryvinskyi\McpServer\Model\Confirmation\ConfirmationStoreInterface" type="Hryvinskyi\McpServer\Model\Confirmation\DbConfirmationStore"/>
    <type name="Hryvinskyi\McpServer\Model\Session\DbSessionStore">
        <arguments>
            <!-- Live sessions one caller may hold; opening one more ends the caller's least recently seen -->
            <argument name="maxSessionsPerCaller" xsi:type="number">20</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Protocol\Server">
        <arguments>
            <!-- The longest request body accepted, in bytes -->
            <argument name="maxBodyBytes" xsi:type="number">1048576</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Protocol\MessageParser">
        <arguments>
            <!-- The most messages one batch may hold -->
            <argument name="maxBatchSize" xsi:type="number">20</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Protocol\ProtocolVersions">
        <arguments>
            <!-- Protocol versions the server speaks, newest first -->
            <argument name="versions" xsi:type="array">
                <item name="v2025_11_25" xsi:type="string">2025-11-25</item>
                <item name="v2025_06_18" xsi:type="string">2025-06-18</item>
                <item name="v2025_03_26" xsi:type="string">2025-03-26</item>
                <item name="v2024_11_05" xsi:type="string">2024-11-05</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Protocol\Dispatcher">
        <arguments>
            <!-- Method handlers keyed by the JSON-RPC method they handle -->
            <argument name="handlers" xsi:type="array">
                <item name="initialize" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Method\Initialize</item>
                <item name="notifications/initialized" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Method\Initialized</item>
                <item name="ping" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Method\Ping</item>
                <item name="tools/list" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Method\ToolsList</item>
                <item name="tools/call" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Method\ToolsCall</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Protocol\Tool\ToolRegistry">
        <arguments>
            <!-- The tools a client sees: abilities are found and run through these, never listed as tools -->
            <argument name="tools" xsi:type="array">
                <item name="discover_abilities" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Tool\DiscoverAbilities</item>
                <item name="get_ability_info" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Tool\GetAbilityInfo</item>
                <item name="execute_ability" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Tool\ExecuteAbility</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Protocol\Tool\ExecuteAbility">
        <arguments>
            <!-- How each invocation outcome is answered, keyed by the outcome's value -->
            <argument name="outcomeAnswers" xsi:type="array">
                <item name="succeeded" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Tool\Outcome\SucceededAnswer</item>
                <item name="failed" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Tool\Outcome\FailedAnswer</item>
                <item name="denied" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Tool\Outcome\DeniedAnswer</item>
                <item name="needs_confirmation" xsi:type="object">Hryvinskyi\McpServer\Model\Protocol\Tool\Outcome\ConfirmationAnswer</item>
            </argument>
        </arguments>
    </type>

    <!-- HTTP transport: the REST request processor of the MCP endpoint -->
    <type name="Hryvinskyi\McpServer\Model\Http\McpRequestProcessor">
        <arguments>
            <!-- What the endpoint does per uppercase HTTP method; any other method is answered with 405 -->
            <argument name="verbs" xsi:type="array">
                <item name="POST" xsi:type="object">Hryvinskyi\McpServer\Model\Http\Verb\PostMessages</item>
                <item name="DELETE" xsi:type="object">Hryvinskyi\McpServer\Model\Http\Verb\EndSession</item>
            </argument>
        </arguments>
    </type>

    <!-- stdio transport: a serving loop that starts one bin/magento process per message, and that process's command -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="hryvinskyiMcpServe" xsi:type="object">Hryvinskyi\McpServer\Console\Command\ServeCommand</item>
                <item name="hryvinskyiMcpStdioMessage" xsi:type="object">Hryvinskyi\McpServer\Console\Command\StdioMessageCommand</item>
            </argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Console\Command\ServeCommand">
        <arguments>
            <!-- Lazy, so that other commands never build the loop -->
            <argument name="loop" xsi:type="object">Hryvinskyi\McpServer\Model\Stdio\StdioLoop\Proxy</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Console\Command\StdioMessageCommand">
        <arguments>
            <!-- Lazy, so that the handler and the services it needs are built after the Web API area is loaded -->
            <argument name="handler" xsi:type="object">Hryvinskyi\McpServer\Model\Stdio\MessageHandler\Proxy</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Stdio\CallerAdmission">
        <arguments>
            <argument name="authorization" xsi:type="object">HryvinskyiMcpServerAuthorization</argument>
        </arguments>
    </type>
    <preference for="Hryvinskyi\McpServer\Model\Stdio\ProcessRunnerInterface" type="Hryvinskyi\McpServer\Model\Stdio\SymfonyProcessRunner"/>
    <preference for="Hryvinskyi\McpServer\Model\Stdio\AdminAccountsInterface" type="Hryvinskyi\McpServer\Model\Stdio\AdminUserAccounts"/>
    <preference for="Hryvinskyi\McpServer\Model\Transport\ChannelSecurityInterface" type="Hryvinskyi\McpServer\Model\Transport\ChannelSecurity"/>
    <type name="Hryvinskyi\McpServer\Model\Stdio\StdioStreams">
        <arguments>
            <argument name="driver" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Stdio\StdioLoop">
        <arguments>
            <!-- How long one message process may run, in seconds -->
            <argument name="messageTimeoutSeconds" xsi:type="number">300</argument>
            <!-- The longest line read from the client, in bytes -->
            <argument name="maxLineBytes" xsi:type="number">1048576</argument>
        </arguments>
    </type>
    <type name="Hryvinskyi\McpServer\Model\Stdio\MessageHandler">
        <arguments>
            <!-- The longest message a message process reads, in bytes -->
            <argument name="maxMessageBytes" xsi:type="number">1048576</argument>
        </arguments>
    </type>
</config>
