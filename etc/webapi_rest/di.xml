<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Answers the MCP endpoint before Magento's own processors would run its placeholder service -->
    <type name="Magento\Webapi\Controller\Rest\RequestProcessorPool">
        <arguments>
            <argument name="requestProcessors" xsi:type="array">
                <item name="hryvinskyiMcp" xsi:type="object" sortOrder="40">Hryvinskyi\McpServer\Model\Http\McpRequestProcessor</item>
            </argument>
        </arguments>
    </type>
</config>
