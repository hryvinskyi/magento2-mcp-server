<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Hryvinskyi_McpServer::mcp_server" title="MCP Server" translate="title" sortOrder="90">
                        <resource id="Hryvinskyi_McpServer::access" title="Use the MCP endpoint" translate="title" sortOrder="10"/>
                        <resource id="Hryvinskyi_McpServer::view" title="View the MCP Server page" translate="title" sortOrder="20"/>
                        <resource id="Hryvinskyi_McpServer::manage" title="Manage ability exposure" translate="title" sortOrder="30"/>
                    </resource>
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Hryvinskyi_McpServer::config" title="MCP Server Settings" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
