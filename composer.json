{
    "name": "hryvinskyi/magento2-mcp-server",
    "description": "MCP server for Magento 2: exposes the store's service contracts to AI clients as abilities, behind an exposure policy and the caller's ACL",
    "type": "magento2-module",
    "version": "1.1.1",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "hryvinskyi/magento2-base": "^2.2",
        "magento/framework": "*",
        "magento/module-authorization": "*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*",
        "magento/module-integration": "*",
        "magento/module-security": "*",
        "magento/module-store": "*",
        "magento/module-ui": "*",
        "magento/module-user": "*",
        "magento/module-webapi": "*",
        "psr/log": "^1 || ^2 || ^3",
        "symfony/console": "^5.4 || ^6.0 || ^7.0",
        "symfony/process": "^5.4 || ^6.0 || ^7.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\McpServer\\": ""
        }
    }
}
