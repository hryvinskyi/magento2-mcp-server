<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hryvinskyi_mcp_server_menu"/>
    <head>
        <css src="Hryvinskyi_McpServer::css/mcp-server.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="hryvinskyi.mcp.server.overview"
                   template="Hryvinskyi_McpServer::server/overview.phtml">
                <arguments>
                    <argument name="overview" xsi:type="object">Hryvinskyi\McpServer\ViewModel\ServerOverview</argument>
                </arguments>
            </block>
            <uiComponent name="hryvinskyi_mcp_ability_listing"/>
        </referenceContainer>
    </body>
</page>
